# SYNTHEX — variables d'environnement
# Copier en .env puis remplir. NE PAS committer le .env réel.

# --- PostgreSQL (MINERVA) ---
POSTGRES_USER=synthex
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=synthex

# --- n8n ---
# Générer : openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# --- Grafana ---
GRAFANA_PASSWORD=change-me

# --- API métriques (metrics-api) ---
# Générer : openssl rand -hex 24
METRICS_API_KEY=

# ====================================================================
# Les 7 clés API à obtenir manuellement (voir README / "reste à faire")
# ====================================================================
ANTHROPIC_API_KEY=
SENDGRID_API_KEY=
HUBSPOT_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PINECONE_API_KEY=
HETZNER_API_TOKEN=
CLOUDFLARE_TUNNEL_TOKEN=
