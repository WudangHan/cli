{
  "name": "SYNTHEX 02 · Stripe → MINERVA → THEMIS → ARES",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "stripe-payment",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "node-webhook",
      "name": "Webhook · Stripe",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 320],
      "webhookId": "stripe-payment"
    },
    {
      "parameters": {
        "jsCode": "const ev = $json.body || $json;\nconst obj = ev.data?.object || {};\nconst amount = (obj.amount_received ?? obj.amount ?? 0) / 100;\nreturn [{ json: {\n  stripe_id: obj.id || ev.id || '',\n  type: ev.type || 'payment_intent.succeeded',\n  amount_cad: amount,\n  currency: (obj.currency || 'cad').toUpperCase(),\n  email: obj.receipt_email || obj.customer_email || '',\n  created: new Date((ev.created || Date.now()/1000) * 1000).toISOString()\n} }];"
      },
      "id": "node-normalize",
      "name": "Normaliser événement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 320]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO transactions (stripe_id, type, amount_cad, currency, email, created_at)\nVALUES ($1, $2, $3, $4, $5, $6)\nON CONFLICT (stripe_id) DO NOTHING\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ $json.stripe_id }},={{ $json.type }},={{ $json.amount_cad }},={{ $json.currency }},={{ $json.email }},={{ $json.created }}"
        }
      },
      "id": "node-minerva",
      "name": "MINERVA · Insert PostgreSQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [760, 320],
      "credentials": {
        "postgres": { "id": "postgres", "name": "SYNTHEX Postgres" }
      }
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst tx = $('Normaliser événement').item.json;\nconst payload = JSON.stringify({ stripe_id: tx.stripe_id, amount_cad: tx.amount_cad, created: tx.created });\nconst hash = crypto.createHash('sha256').update(payload).digest('hex');\nreturn [{ json: { ...tx, audit_hash: hash } }];"
      },
      "id": "node-themis",
      "name": "THEMIS · Hash SHA-256",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1020, 320]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO audit_log (agent, action, subject, hash, created_at)\nVALUES ('THEMIS', 'payment_recorded', $1, $2, NOW());",
        "options": {
          "queryReplacement": "={{ $json.stripe_id }},={{ $json.audit_hash }}"
        }
      },
      "id": "node-auditlog",
      "name": "THEMIS · Write audit_log",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1280, 320],
      "credentials": {
        "postgres": { "id": "postgres", "name": "SYNTHEX Postgres" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [
            { "leftValue": "={{ $json.amount_cad }}", "rightValue": 1000, "operator": { "type": "number", "operation": "gt" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if",
      "name": "Montant > 1 000 CAD ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1540, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.sendgrid.com/v3/mail/send",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"personalizations\": [{ \"to\": [{ \"email\": \"ares@synthex.ai\" }] }],\n  \"from\": { \"email\": \"ares@synthex.ai\", \"name\": \"ARES · Veto financier\" },\n  \"subject\": \"⚠ VETO ARES — transaction {{ $json.amount_cad }} {{ $json.currency }}\",\n  \"content\": [{ \"type\": \"text/plain\", \"value\": \"Transaction supérieure au seuil de 1 000 CAD détectée.\\n\\nID Stripe: {{ $json.stripe_id }}\\nMontant: {{ $json.amount_cad }} {{ $json.currency }}\\nClient: {{ $json.email }}\\nHash audit: {{ $json.audit_hash }}\\n\\nValidation manuelle requise.\" }]\n}",
        "options": {}
      },
      "id": "node-ares",
      "name": "ARES · Email VETO",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1800, 220],
      "credentials": {
        "httpHeaderAuth": { "id": "sendgrid", "name": "SendGrid API Key" }
      }
    }
  ],
  "connections": {
    "Webhook · Stripe": { "main": [[{ "node": "Normaliser événement", "type": "main", "index": 0 }]] },
    "Normaliser événement": { "main": [[{ "node": "MINERVA · Insert PostgreSQL", "type": "main", "index": 0 }]] },
    "MINERVA · Insert PostgreSQL": { "main": [[{ "node": "THEMIS · Hash SHA-256", "type": "main", "index": 0 }]] },
    "THEMIS · Hash SHA-256": { "main": [[{ "node": "THEMIS · Write audit_log", "type": "main", "index": 0 }]] },
    "THEMIS · Write audit_log": { "main": [[{ "node": "Montant > 1 000 CAD ?", "type": "main", "index": 0 }]] },
    "Montant > 1 000 CAD ?": { "main": [[{ "node": "ARES · Email VETO", "type": "main", "index": 0 }], []] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "synthex" }]
}
