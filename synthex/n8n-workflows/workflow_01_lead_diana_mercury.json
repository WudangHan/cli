{
  "name": "SYNTHEX 01 · Lead → DIANA → MERCURY",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-capture",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "node-webhook",
      "name": "Webhook · Formulaire",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 320],
      "webhookId": "lead-capture"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-opus-4-8\",\n  \"max_tokens\": 512,\n  \"system\": \"Tu es DIANA, agent de scoring de leads SYNTHEX. Réponds STRICTEMENT en JSON: {\\\"score\\\": <0-100>, \\\"raison\\\": <string>}. Score élevé = fort potentiel B2B.\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"Lead: nom={{ $json.body.name }}, email={{ $json.body.email }}, entreprise={{ $json.body.company }}, besoin={{ $json.body.message }}\" }\n  ]\n}",
        "options": {}
      },
      "id": "node-diana",
      "name": "DIANA · Scoring (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 320],
      "credentials": {
        "httpHeaderAuth": { "id": "anthropic", "name": "Anthropic API Key" }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.content?.[0]?.text || '{}';\nlet parsed = { score: 0, raison: 'parse_error' };\ntry { parsed = JSON.parse(raw); } catch (e) {}\nreturn [{ json: { ...$('Webhook · Formulaire').item.json.body, score: parsed.score, raison: parsed.raison } }];"
      },
      "id": "node-parse",
      "name": "Parse score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 320]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [
            { "leftValue": "={{ $json.score }}", "rightValue": 70, "operator": { "type": "number", "operation": "gte" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if",
      "name": "Score ≥ 70 ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1020, 320]
    },
    {
      "parameters": {
        "resource": "contact",
        "operation": "create",
        "email": "={{ $json.email }}",
        "additionalFields": {
          "firstName": "={{ $json.name }}",
          "companyName": "={{ $json.company }}"
        }
      },
      "id": "node-hubspot",
      "name": "HubSpot · Créer contact",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [1280, 220],
      "credentials": {
        "hubspotApi": { "id": "hubspot", "name": "HubSpot API" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.sendgrid.com/v3/mail/send",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"personalizations\": [{ \"to\": [{ \"email\": \"{{ $json.email }}\" }] }],\n  \"from\": { \"email\": \"mercury@synthex.ai\", \"name\": \"MERCURY · SYNTHEX\" },\n  \"subject\": \"Bonjour {{ $json.name }}, parlons de {{ $json.company }}\",\n  \"content\": [{ \"type\": \"text/plain\", \"value\": \"Bonjour {{ $json.name }},\\n\\nMerci pour votre intérêt. Votre besoin a retenu notre attention (score interne {{ $json.score }}/100).\\n\\nQuand seriez-vous disponible pour un échange ?\\n\\n— MERCURY, agent de communication SYNTHEX\" }]\n}",
        "options": {}
      },
      "id": "node-mercury",
      "name": "MERCURY · Email (SendGrid)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1280, 400],
      "credentials": {
        "httpHeaderAuth": { "id": "sendgrid", "name": "SendGrid API Key" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://metrics.synthex.ai/internal/audit",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"agent\": \"THEMIS\",\n  \"action\": \"lead_qualified\",\n  \"subject\": \"{{ $json.email }}\",\n  \"meta\": { \"score\": {{ $json.score }} }\n}",
        "options": {}
      },
      "id": "node-themis",
      "name": "THEMIS · Audit log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 320],
      "credentials": {
        "httpHeaderAuth": { "id": "metrics", "name": "Metrics API Key" }
      }
    }
  ],
  "connections": {
    "Webhook · Formulaire": { "main": [[{ "node": "DIANA · Scoring (Claude)", "type": "main", "index": 0 }]] },
    "DIANA · Scoring (Claude)": { "main": [[{ "node": "Parse score", "type": "main", "index": 0 }]] },
    "Parse score": { "main": [[{ "node": "Score ≥ 70 ?", "type": "main", "index": 0 }]] },
    "Score ≥ 70 ?": { "main": [
      [{ "node": "HubSpot · Créer contact", "type": "main", "index": 0 }, { "node": "MERCURY · Email (SendGrid)", "type": "main", "index": 0 }],
      []
    ] },
    "HubSpot · Créer contact": { "main": [[{ "node": "THEMIS · Audit log", "type": "main", "index": 0 }]] },
    "MERCURY · Email (SendGrid)": { "main": [[{ "node": "THEMIS · Audit log", "type": "main", "index": 0 }]] }
  },
